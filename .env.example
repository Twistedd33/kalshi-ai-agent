# Copy to .env for local runs. On Render, set these in the dashboard instead.

# Get a free key at https://the-odds-api.com (sportsbook odds = your "fair" price)
ODDS_API_KEY=

# Pick a long random topic; anyone who knows it can read your alerts
NTFY_TOPIC=kalshi-alerts-change-me-8f3k2
NTFY_SERVER=https://ntfy.sh

# Sports to scan, comma-separated. Keys from config.py SPORTS map.
SPORTS=NFL,NBA,NHL

# Alert when (fair prob - Kalshi ask - fee) >= this, in percentage points
MIN_EDGE_PCT=4
# Ignore contracts priced outside this range (cents)
MIN_PRICE=5
MAX_PRICE=95
# Require at least this many sportsbooks in the consensus
MIN_BOOKS=3

# How often to poll Kalshi (free) vs. sportsbook odds (uses API credits)
KALSHI_POLL_SECONDS=120
ODDS_REFRESH_MINUTES=60

# Re-alert the same market only if edge grows by this many points
REALERT_STEP_PCT=2

# Set to 1 to run a single scan and exit (useful for testing)
RUN_ONCE=0
